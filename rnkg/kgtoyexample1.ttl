gkl:startNode a owl:ObjectProperty ;
    rdfs:domain gkl:Arc ;
    rdfs:range gkl:Node .

gkl:transportationMode a owl:DatatypeProperty ;
    rdfs:domain gkl:AcessRestriction ;
    rdfs:range xsd:string .

gkl:ufi a owl:DatatypeProperty ;
    rdfs:label "ufi (unique feature identifier)" ;
    rdfs:comment "ufi (unique feature identifier) represents the VicMap UFI (unique feature identifier) for this node or link" ;
    rdfs:domain gkl:Link,
        gkl:Node ;
    rdfs:range xsd:integer ;
    skos:definition "indicates same as unique feature identifier for VicMap for this node and link" .

gkl:unmaintained a owl:DatatypeProperty ;
    rdfs:domain gkl:LinkRestriction ;
    rdfs:range xsd:boolean .

gkl:weightLimit a owl:DatatypeProperty ;
    rdfs:domain gkl:LinkRestriction ;
    rdfs:range xsd:string .

<http://www.opengis.net/ont/geosparql> a owl:Ontology ;
    dcterms:replaces <http://www.opengis.net/ont/geosparql/1.0> ;
    vann:preferredNamespacePrefix "geo" ;
    vann:preferredNamespaceUri "http://www.opengis.net/ont/geosparql#"^^xsd:anyURI ;
    rdfs:member geo:Feature,
        geo:Geometry,
        geo:SpatialObject,
        geo:asDGGS,
        geo:asGML,
        geo:asGeoJSON,
        geo:asKML,
        geo:asWKT,
        geo:coordinateDimension,
        geo:defaultGeometry,
        geo:dimension,
        geo:ehContains,
        geo:ehCoveredBy,
        geo:ehCovers,
        geo:ehDisjoint,
        geo:ehEquals,
        geo:ehInside,
        geo:ehMeet,
        geo:ehOverlap,
        geo:hasArea,
        geo:hasBoundingBox,
        geo:hasCentroid,
        geo:hasDefaultGeometry,
        geo:hasGeometry,
        geo:hasLength,
        geo:hasMetricArea,
        geo:hasMetricLength,
        geo:hasMetricPerimeterLength,
        geo:hasMetricSize,
        geo:hasMetricSpatialAccuracy,
        geo:hasMetricSpatialResolution,
        geo:hasMetricVolume,
        geo:hasPerimeterLength,
        geo:hasSerialization,
        geo:hasSize,
        geo:hasSpatialAccuracy,
        geo:hasSpatialResolution,
        geo:hasVolume,
        geo:isEmpty,
        geo:isSimple,
        geo:rcc8dc,
        geo:rcc8ec,
        geo:rcc8eq,
        geo:rcc8ntpp,
        geo:rcc8ntppi,
        geo:rcc8po,
        geo:rcc8tpp,
        geo:rcc8tppi,
        geo:sfContains,
        geo:sfCrosses,
        geo:sfDisjoint,
        geo:sfEquals,
        geo:sfIntersects,
        geo:sfOverlaps,
        geo:sfTouches,
        geo:sfWithin,
        geo:spatialDimension ;
