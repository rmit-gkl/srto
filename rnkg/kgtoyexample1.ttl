    schema:name "has volume"@en .

geo:isEmpty a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain geo:Geometry ;
    rdfs:isDefinedBy geo:,
        <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-properties>,
